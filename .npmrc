# Node heap for npm scripts, chiefly `next build`. The frontend type check
# loads about 10,000 files (the schema files import @aws-amplify/backend, which
# brings the CDK typings) and needs about 2 GiB; Node's default cap on the
# 8 GiB Hosting build box is 2 GiB, so the build died there. See CLAUDE.md.
node-options=--max-old-space-size=4096
