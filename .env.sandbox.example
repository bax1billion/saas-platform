# Per-developer defaults for `npm run sandbox` (docs/bootstrap.md).
# Copy to .env.sandbox (gitignored). A CLI flag wins over this file.

# The sandbox account's SSO profile, never the staging one.
AWS_PROFILE=sandbox

# Which modules the next deploy composes: all, none, or a comma list such as widgets,reports.
# A sandbox that does not exist yet starts with none, then widens (CloudFormation caps one
# stack operation at 2,500 resources). Leave unset once every module is deployed.
# BACKEND_MODULES=none

# Optional: a sandbox identifier other than your system user name.
# SANDBOX_IDENTIFIER=

# Seed two smoke-test organizations and users at deploy (docs/bootstrap.md "Seeding a sandbox").
# Sandboxes only; the deploy refuses it on a branch. Pick any password meeting the pool's policy.
# SANDBOX_SEED=1
# SANDBOX_SEED_PASSWORD=
